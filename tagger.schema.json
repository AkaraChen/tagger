{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AkaraChen/tagger/v1.0.0/tagger.schema.json",
  "title": "Tagger Configuration",
  "description": "Configuration file for Tagger - Git semantic version tag management tool",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "platform": {
      "type": "object",
      "description": "Git hosting platform configuration",
      "properties": {
        "type": {
          "type": "string",
          "description": "Git hosting provider type",
          "enum": ["github", "gitlab", "bitbucket", "gitea"]
        },
        "base": {
          "type": "string",
          "description": "Base URL for the platform (e.g., https://github.com, https://gitlab.company.com). If not specified, uses official default for known platforms.",
          "format": "uri"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "description": "Default behavior settings",
      "properties": {
        "openBrowser": {
          "type": "boolean",
          "description": "Whether to automatically open the browser to the repository actions/pipelines page after pushing a tag",
          "default": true
        },
        "autoPush": {
          "type": "boolean",
          "description": "Whether to automatically push tags to remote without prompting",
          "default": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
