{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AkaraChen/tagger/v1.0.0/tagger.schema.json",
  "title": "Tagger Configuration",
  "description": "Configuration file for Tagger - Git semantic version tag management tool",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "platform": {
      "type": "object",
      "description": "Git hosting platform configuration",
      "properties": {
        "type": {
          "type": "string",
          "description": "Platform type",
          "enum": ["github", "gitlab", "gitea"]
        },
        "base": {
          "type": "string",
          "description": "Base URL for self-hosted instances (e.g., https://github.example.com)",
          "format": "uri"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "description": "Default behavior configuration",
      "properties": {
        "push": {
          "type": "boolean",
          "description": "Default push behavior: true = auto push, false = no push, omit = ask user"
        },
        "messageTemplate": {
          "type": "string",
          "description": "Default tag message template. Use {version} as placeholder for version string",
          "examples": ["Release {version}", "Version {version}"]
        },
        "skipConfirmation": {
          "type": "boolean",
          "description": "Skip the confirmation prompt before creating a tag",
          "default": false
        },
        "openActionPage": {
          "type": "boolean",
          "description": "Whether to open CI page (Actions/Pipelines) after push",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "versioning": {
      "type": "object",
      "description": "Version number configuration",
      "properties": {
        "tagTemplate": {
          "type": "string",
          "description": "Template for stable version tags. Placeholders: {major}, {minor}, {patch}",
          "default": "v{major}.{minor}.{patch}",
          "examples": ["v{major}.{minor}.{patch}", "{major}.{minor}.{patch}", "release-{major}.{minor}.{patch}"]
        },
        "preReleaseTagTemplate": {
          "type": "string",
          "description": "Template for pre-release version tags. Placeholders: {major}, {minor}, {patch}, {preReleaseType}, {preReleaseNum}",
          "default": "v{major}.{minor}.{patch}-{preReleaseType}{preReleaseNum}",
          "examples": ["v{major}.{minor}.{patch}-{preReleaseType}{preReleaseNum}", "v{major}.{minor}.{patch}-{preReleaseType}.{preReleaseNum}"]
        },
        "preReleaseTypes": {
          "type": "array",
          "description": "List of pre-release types in order of progression",
          "items": {
            "type": "string"
          },
          "default": ["alpha", "beta", "rc"],
          "minItems": 1,
          "examples": [["alpha", "beta", "rc"], ["dev", "snapshot", "rc"], ["canary", "beta", "rc"]]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
