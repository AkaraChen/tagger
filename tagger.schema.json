{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AkaraChen/tagger/v1.0.0/tagger.schema.json",
  "title": "Tagger Configuration",
  "description": "Configuration file for Tagger - Git semantic version tag management tool",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "gitHostingProvider": {
      "type": "string",
      "description": "Git hosting provider type",
      "enum": ["GitHub", "Other"],
      "default": "GitHub"
    },
    "github": {
      "type": "object",
      "description": "GitHub-specific configuration",
      "properties": {
        "openActionPage": {
          "type": "boolean",
          "description": "Whether to open GitHub Actions page after push (true) or repository homepage (false)",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "tagTemplate": {
      "type": "object",
      "description": "Tag format templates using placeholders. Supported placeholders: {major}, {minor}, {patch}, {preType}, {preNum}",
      "properties": {
        "release": {
          "type": "string",
          "description": "Template for release tags. Must contain {major}, {minor}, {patch} placeholders.",
          "default": "v{major}.{minor}.{patch}",
          "examples": [
            "v{major}.{minor}.{patch}",
            "{major}.{minor}.{patch}",
            "release/v{major}.{minor}.{patch}"
          ]
        },
        "preRelease": {
          "type": "string",
          "description": "Template for pre-release tags. Must contain {major}, {minor}, {patch}, {preType}, {preNum} placeholders.",
          "default": "v{major}.{minor}.{patch}-{preType}-{preNum}",
          "examples": [
            "v{major}.{minor}.{patch}-{preType}-{preNum}",
            "{major}.{minor}.{patch}-{preType}.{preNum}",
            "release/v{major}.{minor}.{patch}-{preType}-{preNum}"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["gitHostingProvider"],
  "additionalProperties": false
}
