{
  "$schema": "https://raw.githubusercontent.com/AkaraChen/tagger/main/tagger.schema.json",
  "platform": {
    "type": "github"
  },
  "defaults": {
    "push": true,
    "messageTemplate": "Release {version}",
    "skipConfirmation": false,
    "openActionPage": true
  },
  "versioning": {
    "tagTemplate": "v{major}.{minor}.{patch}",
    "preReleaseTagTemplate": "v{major}.{minor}.{patch}-{preReleaseType}{preReleaseNum}",
    "preReleaseTypes": ["alpha", "beta", "rc"]
  }
}
